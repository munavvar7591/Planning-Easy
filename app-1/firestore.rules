rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'admin')
      );
    }

    function isMember() {
      return isAuthenticated() && (
        request.auth.token.role == 'member' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'member')
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ==========================================
    // USERS COLLECTION
    // ==========================================
    match /users/{userId} {
      // Any authenticated user can read profiles (needed for member list in chat/reports/tasks)
      allow read: if isAuthenticated();

      // Only Admin can create new users or delete users
      allow create, delete: if isAdmin();

      // Admin can update any user; Members can only update their own non-sensitive profile fields (phone, whatsapp, address)
      allow update: if isAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'username', 'createdAt'])
      );
    }

    // ==========================================
    // FINANCE COLLECTION
    // ==========================================
    match /finance/{financeId} {
      // Both Admin and Members can view and create finance entries
      allow read, create: if isAuthenticated();

      // STRICT REQUIREMENT: Only ADMIN can edit or delete finance records!
      // Members are strictly forbidden from editing or deleting finance entries.
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // REPORTS COLLECTION
    // ==========================================
    match /reports/{reportId} {
      // Both Admin and Members can view and create reports
      allow read, create: if isAuthenticated();

      // STRICT REQUIREMENT: Only ADMIN can edit or delete reports!
      // Members are strictly forbidden from editing or deleting reports.
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // TASKS COLLECTION
    // ==========================================
    match /tasks/{taskId} {
      // Admin can read all tasks. Members can read tasks assigned to them.
      allow read: if isAuthenticated() && (isAdmin() || resource.data.assignedToUid == request.auth.uid);

      // Only Admin can create and delete tasks
      allow create, delete: if isAdmin();

      // Admin can update any task; Member can ONLY update their assigned task's 'status' and 'updatedAt'
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.assignedToUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
      );
    }

    // ==========================================
    // CONVERSATIONS & CHAT
    // ==========================================
    match /conversations/{convId} {
      // Participants or Admin can read conversation metadata
      allow read: if isAuthenticated() && (
        convId == 'group' ||
        isAdmin() ||
        resource.data.participants.hasAny([request.auth.uid])
      );

      // Only Admin or valid participants can create/update conversations
      // STRICT REQUIREMENT: Member-to-Member private chat is NOT allowed.
      // Private conversations must include the Admin UID.
      allow create: if isAuthenticated() && (
        convId == 'group' ||
        isAdmin() ||
        (request.resource.data.type == 'direct' && request.resource.data.participants.hasAny([request.auth.uid]))
      );

      allow update: if isAuthenticated() && (
        convId == 'group' ||
        isAdmin() ||
        resource.data.participants.hasAny([request.auth.uid])
      );
    }

    match /messages/{messageId} {
      // Users can read messages in group chat or private conversations they are part of
      allow read: if isAuthenticated() && (
        resource.data.conversationId == 'group' ||
        isAdmin() ||
        resource.data.participants.hasAny([request.auth.uid])
      );

      // Authenticated users can send messages to group or their Admin DM
      allow create: if isAuthenticated() && (
        request.resource.data.conversationId == 'group' ||
        isAdmin() ||
        request.resource.data.participants.hasAny([request.auth.uid])
      );

      // Senders can update reactions or delete own messages, Admin can moderate
      allow update: if isAuthenticated();
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.senderUid == request.auth.uid);
    }

    // ==========================================
    // NOTIFICATIONS COLLECTION
    // ==========================================
    match /notifications/{notifId} {
      // Authenticated users can read notifications targeted to them or to 'all'
      allow read: if isAuthenticated() && (
        resource.data.recipientUids.hasAny(['all', request.auth.uid]) ||
        isAdmin()
      );

      // Authenticated users can create notifications triggered by system activities
      allow create: if isAuthenticated();

      // Users can mark notifications as read
      allow update: if isAuthenticated() && (
        resource.data.recipientUids.hasAny(['all', request.auth.uid]) ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // ==========================================
    // AUDIT LOGS (Admin Only & Immutable)
    // ==========================================
    match /auditLogs/{logId} {
      // Only Admin can read audit logs
      allow read: if isAdmin();

      // System / Authenticated actions can append audit logs
      allow create: if isAuthenticated();

      // Logs are strictly immutable once written
      allow update, delete: if false;
    }

    // ==========================================
    // APP SETTINGS & BACKUPS (Admin Only)
    // ==========================================
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
